nd no cheers.\r\n\r\n    Here's to the men who lose!\r\n  The touchstone of true worth is not success;\r\n    There is a higher test--\r\n  Though fate may darkly frown, onward to press,\r\n    And bravely do one's best.\r\n\r\n    Here's to the men who lose!\r\n  It is the", "mimetype": "text/plain", "start_char_idx": 157067, "end_char_idx": 157937, "text_template": "{metadata_str}\n\n{content}", "metadata_template": "{key}: {value}", "metadata_seperator": "\n", "class_name": "TextNode"}, "__type__": "1"}, {"__data__": {"id_": "f7c80db5-16c9-4fb7-aabd-4fe4156793d8", "embedding": [0.029510945, 0.01660229, -0.0024862832, 0.031925835, -0.018687775, 0.010147783, 0.025910396, 0.036957826, -0.008275509, 0.032465056, -0.005950983, 0.017639786, 0.09420514, 0.008277068, 0.05992561, -0.04223847, -0.028297769, 0.014492465, -0.04853636, 0.029880235, 0.024261411, -0.029871907, 0.019316822, -0.017550403, -0.014373638, -0.046001427, 0.031795047, -0.015564761, 0.023909297, -0.021703837, 0.043173704, -0.014918148, 0.010709182, 0.0055350433, 0.04605104, 0.0067167818, -0.023836154, 0.009136424, 0.011749543, -0.032577824, -0.06356885, 0.027280413, -0.010467326, 0.015271873, -0.042346813, -0.014334449, 0.032573167, -0.011113053, -0.007954834, 0.052275315, 0.02872194, 0.0067090355, -0.030834205, 0.029268892, 0.00893537, -0.004758461, -0.0086164875, -0.032879792, 0.008099118, -0.002837082, 0.015571174, 0.008937527, 0.002835328, -0.008585122, -0.00022687024, -0.02328463, 0.0101661505, -0.016175998, -0.0030704287, 0.02647584, -0.03501007, -0.027502464, -0.038338557, 0.04461055, 0.03449975, -0.013840867, 0.062182404, -0.07981799, -0.019975768, 0.037133373, -0.013666656, 0.0054827253, 0.094060175, 0.109070234, 0.034064475, 0.036635827, -0.022054711, -0.031782392, -0.03826124, 0.0012922427, 0.027509104, 0.01672165, -0.015016863, 0.044496637, 0.1125657, -0.002557092, -0.049515005, -0.06334923, 0.0781289, 0.04352766, 0.018022249, -0.031329237, 0.029910514, -0.06328795, 0.028168967, 0.0431168, -
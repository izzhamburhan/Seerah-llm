pots and their colors were gay--\r\n    He wished that his own could be green;\r\n  He dropped his tail, tried to hide it away;", "mimetype": "text/plain", "start_char_idx": 193104, "end_char_idx": 194011, "text_template": "{metadata_str}\n\n{content}", "metadata_template": "{key}: {value}", "metadata_seperator": "\n", "class_name": "TextNode"}, "__type__": "1"}, {"__data__": {"id_": "65755dd3-6a92-4a07-bff0-893503057301", "embedding": [-0.029164763, 0.051192507, 0.013472924, 0.037705697, 0.015015454, 0.028505564, -0.026218196, 0.006084629, 0.016684609, 0.030036915, 0.014906792, 0.009153411, 0.0680322, 0.037197724, 0.048450116, -0.046294775, -0.0005593018, 0.04415754, -0.0456548, 0.07778235, 0.05551858, -0.041132007, 0.022722581, 0.0076265307, -0.097566746, -0.04535831, 0.03954318, -0.050917737, -0.056693204, -0.013586959, 0.024977937, 0.0491146, 0.023525689, -0.007663432, 0.011435809, 0.04993229, -0.049338907, -0.000174551, 0.0011665926, -0.015502424, -0.06684877, 0.067924544, -0.005260349, 0.055464383, -0.018875657, -0.06264171, 0.015173331, 0.009983987, 0.03858138, 0.07396042, 0.08110612, 0.015510036, -0.024553325, 0.039361127, 0.0070344927, 0.0022414322, -0.06776406, -0.049304858, 0.014266858, -0.030795734, -0.008581665, 0.03389563, -0.032106593, 0.020549132, -0.015051751, 0.013488621, -0.045874316, 0.024509188, -0.019671764, 0.04907542, -0.014389715, 0.004814211, -0.022991356, 0.014055332, 0.038782727, -0.043547694, 0.01139105, -0.041140266, -0.0034343086, 0.04404819, 0.0074478127, 0.01527794, 0.09233437, 0.078031875, -0.016209627, 0.012214874, -0.017335696, -0.048786096, -0.018160243, 0.022917729, -9.2109454e-05, 0.03475255, -0.049419764, 0.018240906, 0.09973037, -0.053652473, -0.04792459, -0.055382993, 0.058815297, 0.05146716, 0.021316366, 0.005967518, 0.03647584, -0.04449637, 0.026477203, 0.056988087, -0.094361104, -0.025025, -0.01797104, -0.0076339557, -0.0068892534, -0.01022337, -0.0102522, 0.03265575, 0.018357037, -0.021564353, -0.013418082, 0.006810502, 
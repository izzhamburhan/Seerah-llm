\n  He asked if she ever could love him.\r\n    She laughed till his blushes he hid.\r\n  He asked if she ever could love him.\r\n    By God, she admitted she did.\r\n\r\n\r\n_Gamaliel Bradford_.\r\n\r\nFrom", "mimetype": "text/plain", "start_char_idx": 253348, "end_char_idx": 254282, "text_template": "{metadata_str}\n\n{content}", "metadata_template": "{key}: {value}", "metadata_seperator": "\n", "class_name": "TextNode"}, "__type__": "1"}, {"__data__": {"id_": "4f57bdc7-c9ac-49bd-9f6b-56c10e759f22", "embedding": [-0.014434116, 0.01873611, -0.048543543, 0.01860269, 0.012592776, 0.060674712, 0.013450397, 0.04219123, 0.005786173, 0.052870214, 0.0011077872, 0.03351148, 0.08384968, 0.018686378, 0.027206255, -0.040145565, -0.009799553, -0.0028472017, -0.042040516, 0.05847026, 0.039207697, -0.025847612, 0.011310151, -0.004792481, -0.014879872, -0.042919822, 0.075511165, -0.020360418, -0.01125812, -0.009924054, 0.016525224, -0.004834553, 0.042861488, -0.03721489, 0.028860167, -0.0068361913, 0.020934466, 0.0074467133, -0.0285458, 0.0061479495, -0.06629852, 0.035436444, -0.0036883075, 0.0611262, -0.02047893, -0.029918844, -0.016496554, -0.03872085, -0.020437136, 0.027511377, 0.06029181, 0.008143074, -0.029891793, 0.0069242194, -0.0047446233, -0.0286714, -0.023636999, -0.03137144, 0.043003656, -0.028073184, 0.0089868475, -0.03292309, -0.036207225, -0.007299639, 0.0091713555, -0.025538255, -0.018060576, 0.031108348, -0.037295915, 0.06525812, -0.015829165, 0.050394874, -0.042618323, 0.043767754, -0.014234731, -0.013578495, 0.025613632, -0.030774888, -0.008767538, 0.028639838, -0.015241915, 0.0073863403, 0.07188634, 0.045644265, 0.00129505, 0.014401122, 0.005323374, -0.017922157, -0.05173576, 0.024773264, 0.04758634, 0.06314207, -0.026185406, 0.069673255, 0.09344928, -0.028027257, -0.06520514, -0.05458859, 0.012419603, 0.031931337, 0.010704416, -0.012633462, -0.016582917, -0.07631871, 0.03374352, 0.030528063, -0.04928461, 0.009950171, -0.043846928, -0.005504913, 0.015683338, -0
en\r\n  We part and may not meet again.\r\n\r\n  A smile, a jest, a joke--alas!\r\n  We come, we wonder, and we pass.\r\n    The shadow falls; so long we rest\r\n    In graves, where is no quip or jest.\r\n  Good day! Good cheer! Good-bye! For then\r\n  We part and may not meet again!\r\n\r\n\r\n_James W. Foley._\r\n\r\nFrom \"Friendly Rhymes.\"\r\n\r\n\r\n\r\n\r\nMISTRESS", "mimetype": "text/plain", "start_char_idx": 215658, "end_char_idx": 216455, "text_template": "{metadata_str}\n\n{content}", "metadata_template": "{key}: {value}", "metadata_seperator": "\n", "class_name": "TextNode"}, "__type__": "1"}, {"__data__": {"id_": "bf6c6f2b-75ce-48f8-8518-2a7274da2486", "embedding": [-0.01962133, 0.03528314, -0.0377466, 0.0109779015, 0.015590722, 0.021045731, 0.030100051, 0.048664022, 0.021766767, 0.055248942, -0.0055913646, 0.022897353, 0.057623208, 0.028912587, 0.014714733, -0.085868835, -0.017874662, 0.05227013, -0.064341456, 0.06731685, 0.015739765, -0.02051557, 0.015799627, -0.01949902, -0.007778217, 0.0074092825, 0.03831612, -0.03381735, -0.023128923, -0.0036056505, 0.025615703, 0.019955708, 0.070347056, -0.030479053, 0.049071793, -0.017275298, -0.04926733, 0.033183653, 0.0076389625, 0.0034254775, -0.09539821, 0.020328678, -0.02684272, 0.032781612, -0.029738752, -0.087006174, 0.0068973824, -0.0038338497, -0.019747363, 0.037586864, 0.055624887, -0.005872753, -0.017171688, 0.041332528, 0.038670696, 0.003517494, -0.03884382, -0.017322239, 0.0022381821, 0.0043668277, 0.008866638, 0.075505316, -0.04249639, -0.019382032, 0.0075621507, -0.060654663, -0.021678992, -0.0068213698, -0.016082106, 0.047968596, 0.024055993, 0.03642367, -0.026514554, -0.0018140347, -0.013032498, -0.02351354, 0.037729073, -0.059369225, -0.035987556, 0.01629048, -0.07079155, 0.032964483, 0.08477894, 0.09237459, -0.025828794, -0.01299776, -0.017643478, -0.024464004, -0.028120467, -0.03211403, 0.037568856, 0.027124556, -0.028459655, 0.052374072, 0.08810073, -0.018583363, -0.08431906, -0.063926116, 0
 wither thee,\r\n    'Twill shine again.\r\n  The sky is very black, 'tis true,", "mimetype": "text/plain", "start_char_idx": 294519, "end_char_idx": 295423, "text_template": "{metadata_str}\n\n{content}", "metadata_template": "{key}: {value}", "metadata_seperator": "\n", "class_name": "TextNode"}, "__type__": "1"}, {"__data__": {"id_": "b0c4e24a-aa17-4084-945f-3f031710d246", "embedding": [0.033972763, -0.0043574846, 0.007144977, 0.029562367, -0.03506574, 0.047506932, 0.017344655, 0.016550265, 0.013246286, -0.0010500592, -0.017925657, 0.0497388, 0.05219277, 0.030369744, 0.04122675, -0.021482164, 0.00037476214, 0.017451232, -0.024018642, 0.048360996, 0.036447585, -0.02615186, 0.039287657, -0.064582735, -0.06267136, -0.02026762, 0.03103614, -0.017636262, 0.058113854, -0.033278205, 0.043265864, 0.0684264, -0.0017361172, -0.028617883, 0.01778267, -0.0022845098, 0.00083166285, -0.005760965, 0.01611359, -0.019306108, -0.08782921, 0.03678295, -0.009613391, 0.037726097, -0.048808083, -0.05738727, -0.02162982, 0.006136052, -0.020489898, 0.07691943, 0.019471234, 0.059676904, 0.020465717, 0.08113496, 0.02249477, -0.05931879, 0.0038324124, -0.013116617, 0.017308503, -0.0045358087, 0.05037558, -0.020852955, 0.029595679, -0.018070191, 0.008849635, -0.031050853, -0.019756487, -0.0030769473, -0.006362593, 0.028154535, -0.011399159, 0.0060360655, -0.06142719, 0.066144966, 0.01713259, 0.009062049, 0.0144544095, -0.07187721, -0.029255664, 0.013809068, -0.06888119, 0.036305837, 0.112037525, 0.084615625, 0.057658117, 0.009398371, 0.03838699, -0.045167103, -0.07214843, -0.021170115, -0.0058781058, 0.042427924, 0.00655669, 0.021927884, 0.040756434, -0.0076545267, -0.014278189, -0.09965877, 0.051950265, 0.07924066, -0.012588897, -0.022473628, -0.008625124, -0.06784872, 0.05781813, 0.005157784, -0.028127238, -0.0065126643, -0.029966084, 0.017085515, -0.0036800548, -0.03396337, 0.007388347, -0.017883744, 0.03604745, -0.028413229, 0.033335738, 0.002611924, 0.013425021, -0.0011430115, 0.020880
o forces, and the two\r\ngovernments, can be imagined.\r\n\r\n\r\n  The man who is there with the wallop and punch\r\n    The one who is trained to the minute,\r\n  May well be around when the trouble begins,\r\n    But you seldom will find he is in it;\r\n  For they let him alone when", "mimetype": "text/plain", "start_char_idx": 132792, "end_char_idx": 133732, "text_template": "{metadata_str}\n\n{content}", "metadata_template": "{key}: {value}", "metadata_seperator": "\n", "class_name": "TextNode"}, "__type__": "1"}, {"__data__": {"id_": "183e5b00-fc1d-4a74-95db-66d938345762", "embedding": [0.001178601, -0.012872, -0.0010532946, 0.009630875, 0.011118539, 0.06604263, 0.031490985, 0.065964386, 0.024941834, 0.042966608, -0.004906013, 0.05438947, 0.08626775, 0.039754923, 0.023891596, -0.050833933, 0.044801682, 0.008212686, -0.05561637, 0.025465123, 0.026012355, -0.011843941, 0.027819304, -0.011474572, -0.068062164, -0.10397634, 0.06731745, -0.02442135, 0.0040405244, -0.03087098, 0.051290907, 0.05575806, 0.044668127, -0.0050011617, -0.01290466, 0.029837446, 0.0004744206, -0.0029174357, 0.019327829, -0.032562066, -0.084545754, 0.014718413, -0.0027012164, 0.032173783, -0.01322013, -0.049927793, -0.006935647, -0.012813857, -0.0352774, 0.029127277, 0.06499909, 0.032883804, -0.023584185, 0.061323747, 0.007288179, -0.031746224, -0.02368713, -0.018133242, -0.0045527434, -0.016995834, 0.04778748, 0.016869375, -0.015323518, -0.021671697, -0.0014214178, 0.016982717, -0.0018096368, 0.004314358, 0.017318938, 0.046726905, 0.011322906, 0.04635132, -0.02420369, 0.026921531, 0.005143003, 0.018315198, 0.048417587, -0.016436215, -0.017325534, 0.013493451, -0.029477162, 0.037441526, 0.050765306, 0.08444108, 0.047907818, 0.006260635, 0.012067817, -0.05991551, -0.04703066, -0.020878688, 0.046379987, 0.013457812, -0.012615559, 0.04765265, 0.042707004, -0.023386408, -0.046612617, -0.06571581, 0.11213058, 0.101168334, -0.012420461, -0.015331127, 0.021162283, -0.0250988, 0.046738837, 0.0395156
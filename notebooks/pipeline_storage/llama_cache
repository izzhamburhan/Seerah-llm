.\"\r\n\r\n\r\n\r\n\r\nBORROWING TROUBLE\r\n\r\n\r\nIt is bad enough to cry over", "mimetype": "text/plain", "start_char_idx": 299685, "end_char_idx": 300467, "text_template": "{metadata_str}\n\n{content}", "metadata_template": "{key}: {value}", "metadata_seperator": "\n", "class_name": "TextNode"}, "__type__": "1"}, {"__data__": {"id_": "4c9ccce3-2c70-49f4-8bfc-a592f34e197d", "embedding": [0.01619649, 0.06514745, 0.00583033, -0.014131803, -0.020256143, -0.0029738795, 0.022223577, 0.0501252, 0.0076940157, 0.04950385, -0.016156876, 0.033692695, 0.083166, 0.04899804, 0.07101318, -0.05727862, -0.011029252, 0.0001044928, -0.042699277, 0.026749438, 0.025789484, -0.030260246, 0.019426467, -0.051607713, -0.07926145, 0.0035810454, 0.01401825, -0.0038231227, 0.0038562042, -0.02396924, 0.031750962, 0.05223996, 0.045447957, 0.010039025, 0.08451115, 0.02654998, -0.044506155, 0.017206041, -0.027925314, -0.020228177, -0.055096515, 0.012992548, -0.027049955, 0.042976964, 0.014598181, -0.028116163, 0.0076150266, 0.037570376, 0.027656907, 0.07807664, 0.02378932, -0.00281147, -0.05441776, 0.013981163, -0.016940147, -0.03857713, 0.00022941396, -0.043563236, 0.031190982, -0.02439829, -0.030540358, 0.0072757467, -0.014843158, 0.009602811, -0.017025445, -0.021272013, -0.03828295, 0.037508417, -0.07156134, 0.021850547, -0.06314093, 0.0123983305, -0.014062157, 0.012980896, 0.0545988, -0.054487906, 0.019821497, -0.03283297, 0.012099608, 0.037710387, -0.03927547, 0.018914258, 0.10250056, 0.06815844, 0.03085371, 0.027898058, -0.078164674, -0.043556586, -0.055715147, 0.0047298716, 0.053747483, 0.020626826, -0.035965316, 0.013817088, 0.09225483, -0.010427786, -0.08548827, -0.020288799, 0.07685698, 0.043650225, 0.06196286, 0.055836115, 0.0038233816, -0.050712574, 0.022832945, 0.05159547, 0.0019928028, -0.01702337, -0.043839343, 0.031217735, 0.015865501, -0.053035393, 0.023233458, -0.049531344, 0.051669315, -0.00013207627, 0.007829621, 0.021761704, -0.014131287, -0.019686855, 0.016052872, 0.03318
 going God's way.\r\n\r\n  For what are we thankful for? For all:", "mimetype": "text/plain", "start_char_idx": 270499, "end_char_idx": 271308, "text_template": "{metadata_str}\n\n{content}", "metadata_template": "{key}: {value}", "metadata_seperator": "\n", "class_name": "TextNode"}, "__type__": "1"}, {"__data__": {"id_": "38ea9eec-fd45-4983-92f0-07856a0d6ac6", "embedding": [0.04844627, 0.009896464, -0.022928772, 0.0516288, -0.035119213, 0.024265666, 0.025478004, 0.08332722, 0.019388087, 0.010296741, -0.0041008024, -0.0110838255, 0.055449653, -0.005818024, 0.07910482, -0.039041277, -0.026418857, 0.0024635193, -0.04399429, 0.049345657, 0.056223948, -0.018179076, -0.050752506, -0.019119415, -0.04439354, -0.036303114, 0.06708924, -0.02616001, 0.025975453, -0.05305819, 0.04070979, 0.02446791, 0.014264568, -0.01757044, 0.0009366571, -0.0072793723, -0.01874227, -0.010980799, 0.01778462, -0.0031182303, -0.10664615, -0.017471587, 0.024253942, 0.041004777, -0.016658539, -0.0072057196, 0.016271919, 0.0028507488, 0.01932493, 0.056986526, 0.04147759, 0.025149373, 0.018995166, 0.018306255, 0.021963295, -0.048372917, -0.034000482, -0.019763742, 0.018510947, -0.017750027, 0.0021273145, 0.027411662, -0.026443286, -0.047094163, -0.019879162, 0.016485536, 0.010060118, 0.015566133, -0.046319254, 0.07245095, 0.0169292, 0.008389199, -0.03275046, 0.049092058, 0.020662975, 0.0070136716, -0.023367299, -0.06482345, -0.027857421, 0.007805655, -0.039456382, 0.022006843, 0.10809151, 0.06924677, -0.0005109279, -0.023651887, 0.002484307, -0.032769162, -0.025313755, 0.010756681, 0.041851908, 0.061008707, 0.008319665, -0.020553678, 0.06632979, 0.025661018, -0.03814987, -0.068073206, 0.07098534, 0.08100727, 0.024734309, 0.0025950256, 0.0077985693, -0.046211466, 0.055143002, 0.031474855, -0.02645806, -0.025600253, -0.040606707, -0.05700108, 0.008225801, -0.08114305, 0.012401049, 0.034665693, 0.021338403, -0.06244632, 0.018366981, 0.017265197, -0.046980564, 0.005264852, 0.0039718146, 0.021933425, -0
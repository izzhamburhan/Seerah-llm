s from wrong;\r\n  And the most ancient Heavens, through Thee, are fresh and strong.\r\n\r\n    To humbler functions, awful Power!\r\n    I call thee: I myself commend\r\n    Unto thy guidance from this hour;\r\n    Oh let my weakness have an end!\r\n    Give unto me, made lowly wise,\r\n    The spirit of self-sacrifice;", "mimetype": "text/plain", "start_char_idx": 284480, "end_char_idx": 285333, "text_template": "{metadata_str}\n\n{content}", "metadata_template": "{key}: {value}", "metadata_seperator": "\n", "class_name": "TextNode"}, "__type__": "1"}, {"__data__": {"id_": "0c4e0f35-186a-4fc2-b130-062f93f725a4", "embedding": [0.057248857, 0.04053497, -0.010474256, -0.0023775864, -0.046152737, 0.02835619, -0.013817022, 0.059628125, -0.0020315803, 0.059443694, 0.041154433, -0.008031355, 0.091065444, 0.038155995, 0.045920428, -0.05006541, -0.028073069, 0.0042202096, -0.07956183, 0.012427881, 0.04581841, 0.0035928544, -0.025023544, -0.052846048, -0.049569126, -0.006414811, 0.030931385, 0.013949264, 0.024728939, -0.0060113133, 0.09109719, 0.060859628, 0.033619553, -0.013265684, 0.0583181, 0.031994555, -0.056331277, 0.007815025, 0.02680141, -0.06724036, -0.03103638, 0.019379986, 0.039424635, 0.03481105, -0.04591827, -0.010338471, 0.017561534, 0.049035404, 0.008332078, 0.04634202, 0.040975712, 0.02653784, -0.024683487, 0.0153182745, -0.044122115, -0.008364798, 0.0072479597, -0.009393875, 0.020304574, -0.0071993833, -0.005154699, 0.0061400076, -0.0017455635, -0.012581596, -0.015031848, 0.0137757445, -0.044827327, 0.036556587, -0.021671861, 0.09527407, 0.022305148, 0.0041825036, -0.041418564, 0.008107366, 0.027702942, -0.016850982, 0.0035955922, -0.0049062674, -0.023081208, 0.030946877, -0.030216558, -0.0038867726, 0.055780817, 0.022716817, -0.0109001305, 0.014849841, -0.037899897, -0.06278905, -0.05935006, -0.012212897, -0.021547323, 0.06540285, -0.002851879, 0.004463456, 0.04710265, -0.0031943978, -0.06788201, -0.041748818, 0.04269169, 0.074097626, 0.04949236, 0.02172771
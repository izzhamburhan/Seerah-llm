ear to fall.\r\n\r\n  A chance may win that by mischance was lost;\r\n    That net that holds no great takes little fish;\r\n  In some things all, in all things none are", "mimetype": "text/plain", "start_char_idx": 191471, "end_char_idx": 192375, "text_template": "{metadata_str}\n\n{content}", "metadata_template": "{key}: {value}", "metadata_seperator": "\n", "class_name": "TextNode"}, "__type__": "1"}, {"__data__": {"id_": "7ecd4f12-e2dd-4191-af0f-a6d9a84b3ccc", "embedding": [-0.0012795525, 0.050051264, 0.0077984314, 0.043633614, 0.008607806, -0.02010752, 0.03720073, 0.02810036, 0.04974134, 0.0435753, -0.0011103072, 0.02935723, 0.08390895, 0.013499241, 0.030473297, -0.018465927, -0.01796671, -0.010971556, -0.0652356, 0.03594512, 0.023876544, 0.008290393, 0.025054825, -0.009903087, -0.04198411, -0.0043732636, 0.03440401, 0.00017580614, 0.025290724, -0.017955469, 0.020221423, 0.036242492, 0.02674254, -0.046763938, -0.005295732, 0.019665554, -0.035619743, 0.014066312, 0.02800833, -0.026591368, -0.07670905, 0.02169321, -0.010947342, 0.038413987, -0.061014283, -0.0634108, -0.0023320138, 0.018884636, -0.023386542, 0.062080726, 0.032283265, -0.011184984, -0.009925223, 0.007975762, -0.027364751, -0.042119056, -0.012054545, -0.017287264, 0.024386575, -0.016404618, 0.032113746, -0.011002307, -0.028760143, -0.020167973, -0.018795248, 0.002499088, -0.010935657, -0.0028009368, -0.041366074, 0.05740167, -0.024252065, 0.027252477, -0.057445362, 0.047056906, -0.010013511, -0.015384125, 0.031758603, -0.021544801, -0.032496914, 0.030618861, -0.034082033, -0.01996243, 0.10086985, 0.0754893, 0.034118004, -0.023203589, -0.033760652, -0.028465593, -0.07370209, -0.042898905, 0.016523248, 0.032097943, -0.0095516965, 0.09483048, 0.11516413, -0.018809516, -0.095419355, -0.062451825, 0.041634176, 0.026728677, -0.01453217, 0.014184175, -0.010065211, -0.065845974, 0.020181354, 0.03845934, -0.0047081774, -0.02909961, -0.042117484, -0.03784679, -0.002641689, -0.055167545, 0.019706033, 0.0140532